import socket
from machine import Pin, PWM, time_pulse_us
import time
import network

# --- AP SETUP ---
ap = network.WLAN(network.AP_IF)
ap.active(True)
ap.config(essid="Biped-Robot", password="password123")
print("AP Created. Connect to: Biped-Robot")

# --- 1. SERVO & HARDWARE CONFIGURATION ---
pwm_lt = PWM(Pin(5, Pin.OUT), freq=50)
pwm_lc = PWM(Pin(16, Pin.OUT), freq=50)
pwm_rt = PWM(Pin(18, Pin.OUT), freq=50)
pwm_rc = PWM(Pin(23, Pin.OUT), freq=50)
trig = Pin(13, Pin.OUT)
echo = Pin(14, Pin.IN)

def set_angle(pwm_channel, angle):
    duty = int(40 + (angle / 180) * 75)
    pwm_channel.duty(duty)

def stand_straight():
    set_angle(pwm_lt, 90); set_angle(pwm_lc, 90)
    set_angle(pwm_rt, 90); set_angle(pwm_rc, 90)

def get_distance():
    trig.value(0); time.sleep_us(5)
    trig.value(1); time.sleep_us(10)
    trig.value(0)
    duration = time_pulse_us(echo, 1, 30000)
    if duration < 0: return 999
    return (duration * 0.0343) / 2

# --- 2. HTML INTERFACE ---
html_page = """
<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    body { font-family: sans-serif; text-align: center; background: #f4f4f4; padding: 20px; }
    .btn { display: block; width: 90%; margin: 10px auto; padding: 20px; font-size: 18px; border-radius: 10px; border: none; color: white; }
</style>
</head>
<body>
    <h1>Biped Controller</h1>
    <button class="btn" style="background:#3498db" onclick="fetch('/forward')">Forward</button>
    <button class="btn" style="background:#2ecc71" onclick="fetch('/auto')">Auto-Walk (w/ Obstacle)</button>
    <button class="btn" style="background:#3498db" onclick="fetch('/backward')">Backward</button>
    <button class="btn" style="background:#9b59b6" onclick="fetch('/dance')">Dance</button>
    <button class="btn" style="background:#e74c3c" onclick="fetch('/stop')">Stop</button>
</body>
</html>
"""

# --- 3. SERVER & LOGIC ---
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('', 80))
s.listen(5)
s.settimeout(0.1)

stand_straight()
step_phase = 0 # 0=Idle, 1-4=Walking
print("Server Online!")

while True:
    # 1. Handle Web Commands
    try:
        client, addr = s.accept()
        request = client.recv(1024).decode('utf-8')
        endpoint = request.split(' ')[1] if len(request.split(' ')) > 1 else ""
        
        if "/forward" in endpoint:
            # Manual forward walk
            set_angle(pwm_lc, 70); set_angle(pwm_rc, 70); time.sleep(0.2)
            set_angle(pwm_rt, 115); set_angle(pwm_lt, 115); time.sleep(0.2)
            set_angle(pwm_lc, 110); set_angle(pwm_rc, 110); time.sleep(0.2)
            set_angle(pwm_lt, 65); set_angle(pwm_rt, 65); time.sleep(0.2)
        elif "/auto" in endpoint: step_phase = 1
        elif "/stop" in endpoint: step_phase = 0; stand_straight()
        elif "/backward" in endpoint:
            set_angle(pwm_lc, 110); set_angle(pwm_rc, 110); time.sleep(0.2)
            set_angle(pwm_lt, 65); set_angle(pwm_rt, 65); time.sleep(0.2)
            set_angle(pwm_lc, 70); set_angle(pwm_rc, 70); time.sleep(0.2)
            set_angle(pwm_lt, 115); set_angle(pwm_rt, 115); time.sleep(0.2)
        elif "/dance" in endpoint:
            for i in range(3):
                set_angle(pwm_lt, 60); set_angle(pwm_rt, 120); time.sleep(0.3)
                set_angle(pwm_lt, 120); set_angle(pwm_rt, 60); time.sleep(0.3)
            stand_straight()
            
        client.send('HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n' + html_page)
        client.close()
    except: pass

    # 2. Autonomous Obstacle Avoidance Loop
    if step_phase > 0:
        dist = get_distance()
        if dist < 20.0:
            stand_straight()
        else:
            if step_phase == 1: set_angle(pwm_lc, 70); set_angle(pwm_rc, 70); step_phase = 2
            elif step_phase == 2: set_angle(pwm_rt, 115); set_angle(pwm_lt, 115); step_phase = 3
            elif step_phase == 3: set_angle(pwm_lc, 110); set_angle(pwm_rc, 110); step_phase = 4
            elif step_phase == 4: set_angle(pwm_lt, 65); set_angle(pwm_rt, 65); step_phase = 1
            time.sleep(0.3)
