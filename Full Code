import socket
from machine import Pin, PWM, time_pulse_us
import time
import network

ap = network.WLAN(network.AP_IF)
ap.active(True)
ap.config(essid="Biped-Robot", password="password123")
print("AP Created. Connect to: Biped-Robot")

# --- 1. SERVO & HARDWARE CONFIGURATION ---
pwm_lt = PWM(Pin(5, Pin.OUT), freq=50) # Left Thigh
pwm_lc = PWM(Pin(16, Pin.OUT), freq=50) # Left Calf/Ankle
pwm_rt = PWM(Pin(18, Pin.OUT), freq=50) # Right Thigh
pwm_rc = PWM(Pin(19, Pin.OUT), freq=50) # Right Calf/Ankle

# Ultrasonic Pin Configuration
trig = Pin(13, Pin.OUT)
echo = Pin(14, Pin.IN)

def set_angle(pwm_channel, angle):
    duty = int(40 + (angle / 180) * 75)
    pwm_channel.duty(duty)

def stand_straight():
    set_angle(pwm_lt, 90); set_angle(pwm_lc, 90)
    set_angle(pwm_rt, 90); set_angle(pwm_rc, 90)

def get_distance():
    trig.value(0)
    time.sleep_us(5)
    trig.value(1)
    time.sleep_us(10)
    trig.value(0)
    
    duration = time_pulse_us(echo, 1, 30000)
    if duration < 0: 
        return 999 
    return (duration * 0.0343) / 2

print("🚀 Running Autonomous Code (No Head Servo)!")
stand_straight()
time.sleep(2.0)

step_phase = 1


while True:
    distance = get_distance()
        
        # Check if obstacle is closer than 20cm
    if distance < 20.0:
        print("🛑 Obstacle at", round(distance, 1), "cm! Performing pivot.")
            # Emergency stop
        stand_straight()
            
            # --- BLIND PIVOT MANEUVER ---
            # You can replace this with your preferred turn-away sequence
        set_angle(pwm_lc, 70); set_angle(pwm_rc, 110)
        time.sleep(0.5)
        stand_straight()
            
    else:
            # --- NON-BLOCKING FORWARD WALK ---
        if step_phase == 1:
            set_angle(pwm_lc, 80); set_angle(pwm_rc, 80)
            step_phase = 2
        elif step_phase == 2:
            set_angle(pwm_rt, 105); set_angle(pwm_lt, 105)
            step_phase = 3
        elif step_phase == 3:
            set_angle(pwm_lc, 100); set_angle(pwm_rc, 100)
            step_phase = 4
        elif step_phase == 4:
            set_angle(pwm_lt, 75); set_angle(pwm_rt, 75)
            step_phase = 1
                
        time.sleep(0.3)

