# --- 3. SOCKET SERVER INITIATION ---
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)

# Add this line to allow the port to be reused immediately:
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)

s.bind(('', 80))
s.listen(5)
stand_straight()
print(" Biped Web Control Server online! Open the ESP32 IP in your browser.")

# --- 4. ENGINE ROUTING CORE ---
while True:
    try:
        client, addr = s.accept()
        request = client.recv(1024).decode('utf-8')
        
        # Read the URL endpoint from the header request
        first_line = request.split('\r\n')[0]
        endpoint = first_line.split(' ')[1] if len(first_line.split(' ')) > 1 else ""
        
        if "/forward" in endpoint:
            print("🚀 Action: Forward Step")
            set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.15)
            set_angle(pwm_rt, 105); set_angle(pwm_lt, 105); time.sleep(0.2)
            set_angle(pwm_lc, 100); set_angle(pwm_rc, 100); time.sleep(0.15)
            set_angle(pwm_lt, 75); set_angle(pwm_rt, 75); time.sleep(0.2)
            
        elif "/backward" in endpoint:
            print("🚶 Action: Backward Step")
            set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.15)
            set_angle(pwm_rt, 75); set_angle(pwm_lt, 75); time.sleep(0.25)
            set_angle(pwm_lc, 100); set_angle(pwm_rc, 100); time.sleep(0.15)
            set_angle(pwm_lt, 105); set_angle(pwm_rt, 105); time.sleep(0.25)
            
        elif "/avoid" in endpoint:
            print("👁️ Action: Ultrasonic Distance Scan")
            distance = get_distance()
            print("Scanned distance:", round(distance, 1), "cm")
            
            if distance < 15.0:
                print("⚠️ Obstacle! Executing reverse pivot escape sequence...")
                stand_straight(); time.sleep(0.15)
                # Quick Step Back
                set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.15)
                set_angle(pwm_rt, 75); set_angle(pwm_lt, 75); time.sleep(0.25)
                # Clear left twist rotation
                set_angle(pwm_lt, 75); set_angle(pwm_rt, 105); time.sleep(0.3)
                stand_straight()
            else:
                # Walk forward 1 cycle safely if clear
                set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.15)
                set_angle(pwm_rt, 105); set_angle(pwm_lt, 105); time.sleep(0.2)
                
        elif "/dance" in endpoint:
            print("🎶 Action: Dance Shimmy Shake")
            # Step left/right bounce
            set_angle(pwm_lc, 75); set_angle(pwm_rc, 75); time.sleep(0.15)
            set_angle(pwm_lc, 105); set_angle(pwm_rc, 105); time.sleep(0.15)
            # Twist hips
            set_angle(pwm_lt, 110); set_angle(pwm_rt, 110); time.sleep(0.15)
            set_angle(pwm_lt, 70); set_angle(pwm_rt, 70); time.sleep(0.15)
            stand_straight()
            
        elif "/stop" in endpoint:
            print("🛑 Action: Emergency Stop Protocol")
            stand_straight()

        # Compile and pipe the responsive webpage dashboard down to the browser client
        response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n" + html_page
        client.send(response.encode('utf-8'))
        client.close()
        
    except Exception as e:
        if 'client' in locals():
            client.close()
