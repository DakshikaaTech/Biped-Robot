# --- 3. SOCKET SERVER INITIATION ---
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('', 80))
s.listen(5)
s.setblocking(False)

stand_straight()

# --- 4. ENGINE ROUTING CORE ---
while True:
    try:
        client, addr = s.accept()
        request = client.recv(1024).decode('utf-8')
        
        first_line = request.split('\r\n')[0]
        endpoint = first_line.split(' ')[1] if len(first_line.split(' ')) > 1 else ""
        
        if "/stop" in endpoint:
            print("🛑 EMERGENCY STOP")
            current_action = "stop"
            stand_straight()
        elif "/forward" in endpoint:
            print("🚀 Target: Forward")
            current_action = "forward"
        elif "/backward" in endpoint:
            print("🚶 Target: Backward")
            current_action = "backward"
        elif "/dance" in endpoint:
            print("🎶 Target: Dance")
            current_action = "dance"

        response = "HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n" + html_page
        client.send(response.encode('utf-8'))
        client.close()
        
    except OSError:
        pass

    # --- 5. INDEPENDENT STEPPING ENGINE ---
    if current_action == "forward":
        set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.3)
        set_angle(pwm_rt, 105); set_angle(pwm_lt, 105); time.sleep(0.35)
        set_angle(pwm_lc, 100); set_angle(pwm_rc, 100); time.sleep(0.3)
        set_angle(pwm_lt, 75); set_angle(pwm_rt, 75); time.sleep(0.35)
        
    elif current_action == "backward":
        set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.3)
        set_angle(pwm_rt, 75); set_angle(pwm_lt, 75); time.sleep(0.35)
        set_angle(pwm_lc, 100); set_angle(pwm_rc, 100); time.sleep(0.3)
        set_angle(pwm_lt, 105); set_angle(pwm_rt, 105); time.sleep(0.35)
        
    elif current_action == "dance":
        set_angle(pwm_lc, 75); set_angle(pwm_rc, 75); time.sleep(0.2)
        set_angle(pwm_lc, 105); set_angle(pwm_rc, 105); time.sleep(0.2)
        set_angle(pwm_lt, 110); set_angle(pwm_rt, 110); time.sleep(0.2)
        set_angle(pwm_lt, 70); set_angle(pwm_rt, 70); time.sleep(0.2)

    time.sleep(0.02)
