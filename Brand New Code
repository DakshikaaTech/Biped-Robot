import socket
from machine import Pin, PWM, time_pulse_us
import time
import network

# --- AP SETUP ---
ap = network.WLAN(network.AP_IF)
ap.active(True)
ap.config(essid="Biped-Robot", password="password123")
print("AP Created. Connect to: Biped-Robot")
print("IP address: 192.168.4.1")

# --- 1. SERVO & HARDWARE CONFIGURATION ---
pwm_lt = PWM(Pin(5, Pin.OUT), freq=50)
pwm_lc = PWM(Pin(16, Pin.OUT), freq=50)
pwm_rt = PWM(Pin(18, Pin.OUT), freq=50)
pwm_rc = PWM(Pin(19, Pin.OUT), freq=50)
trig = Pin(13, Pin.OUT)
echo = Pin(14, Pin.IN)

def set_angle(pwm_channel, angle):
    duty = int(40 + (angle / 180) * 75)
    pwm_channel.duty(duty)

def stand_straight():
    set_angle(pwm_lt, 90); set_angle(pwm_lc, 90)
    set_angle(pwm_rt, 90); set_angle(pwm_rc, 90)

def get_distance():
    trig.value(0); time.sleep_us(5)
    trig.value(1); time.sleep_us(10)
    trig.value(0)
    duration = time_pulse_us(echo, 1, 30000)
    if duration < 0: return 999
    return (duration * 0.0343) / 2

# --- 2. HTML INTERFACE ---
html_page = """<!DOCTYPE html>
<html>
<head><meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
    body { font-family: sans-serif; text-align: center; background: #f4f4f4; padding: 20px; }
    .btn { display: block; width: 90%; margin: 10px auto; padding: 20px; font-size: 18px; border-radius: 10px; border: none; color: white; cursor: pointer; }
</style>
</head>
<body>
    <h1>Biped Controller</h1>
    <button class="btn" style="background:#3498db" onclick="fetch('/forward')">Forward</button>
    <button class="btn" style="background:#2980b9" onclick="fetch('/backward')">Backward</button>
    <button class="btn" style="background:#2ecc71" onclick="fetch('/auto')">Auto-Walk (w/ Obstacle)</button>
    <button class="btn" style="background:#e74c3c" onclick="fetch('/stop')">Stop</button>
    <button class="btn" style="background:#9b59b6" onclick="fetch('/dance')">Dance</button>
</body>
</html>"""

# --- 3. SERVER & LOGIC ---
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(('', 80))
s.listen(5)
s.settimeout(0.05) # Fast timeout to keep the main loop responsive

stand_straight()
robot_mode = "IDLE" # Modes: IDLE, FORWARD, BACKWARD, AUTO, DANCE
step_phase = 1
last_step_time = time.ticks_ms()
step_delay = 300 # ms between walk phases

print("Server Online!")

while True:
    # 1. Handle Web Commands Non-Blocking
    try:
        client, addr = s.accept()
        request = client.recv(1024).decode('utf-8')
        endpoint = request.split(' ')[1] if len(request.split(' ')) > 1 else ""
        
        if "/forward" in endpoint:
            print("Mode: Forward")
            robot_mode = "FORWARD"
            step_phase = 1
        elif "/backward" in endpoint:
            print("Mode: Backward")
            robot_mode = "BACKWARD"
            step_phase = 1
        elif "/auto" in endpoint:
            print("Mode: Auto-Walk")
            robot_mode = "AUTO"
            step_phase = 1
        elif "/stop" in endpoint:
            print("Mode: Stop")
            robot_mode = "IDLE"
            stand_straight()
        elif "/dance" in endpoint:
            print("Mode: Dance")
            robot_mode = "DANCE"
            
        client.send('HTTP/1.1 200 OK\r\nContent-Type: text/html\r\n\r\n' + html_page)
        client.close()
    except OSError:
        pass # No incoming connection, continue loop

    # 2. Non-Blocking State Machine for Robot Movements
    current_time = time.ticks_ms()
    
    if robot_mode == "FORWARD" or robot_mode == "AUTO":
        # If in auto-mode, check safety distance first
        if robot_mode == "AUTO" and get_distance() < 20.0:
            stand_straight()
        elif robot_mode == "AUTO" and get_distance()>20.0:
            set_angle(pwm_lc, 70)   
            set_angle(pwm_rc, 70)   
            time.sleep(0.3)
        
        # --- STEP 2: Step Right Foot Forward ---
        # Right thigh swings forward, left thigh pushes backward
            set_angle(pwm_rt, 110)  
            set_angle(pwm_lt, 110)  
            time.sleep(0.3)
        
        # --- STEP 3: Shift Weight Right & Lean ---
        # Ankle angles invert to lean the torso over the right foot
            set_angle(pwm_lc, 110)  
            set_angle(pwm_rc, 110)  
            time.sleep(0.3)
        
        # --- STEP 4: Step Left Foot Forward ---
        # Left thigh swings forward, right thigh pushes backward
            set_angle(pwm_lt, 70)   
            set_angle(pwm_rt, 70)   
            time.sleep(0.3)

        else:
            if time.ticks_diff(current_time, last_step_time) > step_delay:
                last_step_time = current_time
                if step_phase == 1:
                    set_angle(pwm_lc, 70); set_angle(pwm_rc, 70); time.sleep(0.3); step_phase = 2
                elif step_phase == 2:
                    set_angle(pwm_rt, 110); set_angle(pwm_lt, 110); time.sleep(0.3); step_phase = 3
                elif step_phase == 3:
                    set_angle(pwm_lc, 110); set_angle(pwm_rc, 110); time.sleep(0.3); step_phase = 4
                elif step_phase == 4:
                    set_angle(pwm_lt, 70); set_angle(pwm_rt, 70); time.sleep(0.3); step_phase = 1

    elif robot_mode == "BACKWARD":
        set_angle(pwm_lc, 80); set_angle(pwm_rc, 80); time.sleep(0.3)
        set_angle(pwm_rt, 75); set_angle(pwm_lt, 75); time.sleep(0.35)
        set_angle(pwm_lc, 100); set_angle(pwm_rc, 100); time.sleep(0.3)
        set_angle(pwm_lt, 105); set_angle(pwm_rt, 105); time.sleep(0.35)
    elif robot_mode == "DANCE":
        for _ in range(15):
            set_angle(pwm_lt, 60); set_angle(pwm_rt, 120); time.sleep(0.2)
            set_angle(pwm_lt, 120); set_angle(pwm_rt, 60); time.sleep(0.2)
            
            
        

